{
  "name": "musikkvideouka",
  "productName": "Musikkvideouka",
  "version": "2.0.0",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node scripts/start-desktop.cjs",
    "dev": "node scripts/start-desktop.cjs",
    "start:desktop": "node scripts/start-desktop.cjs",
    "start:browser": "node scripts/dev-server.cjs",
    "test": "node --test tests/*.test.js",
    "test:app": "node scripts/run-smoke.cjs",
    "icons": "node scripts/build-icons.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg"
  },
  "keywords": [],
  "author": "Musikkvideouka",
  "license": "ISC",
  "description": "Poengtavle og publikumsvisning for Musikkvideouka",
  "dependencies": {
    "fflate": "^0.8.3",
    "read-excel-file": "^9.3.14"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "no.musikkvideouka.scoreboard",
    "productName": "Musikkvideouka",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "assets/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "mvuka",
        "name": "Musikkvideouka-prosjekt",
        "role": "Editor",
        "icon": "assets/icon.ico"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Musikkvideouka"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.entertainment",
      "target": "dmg",
      "fileAssociations": [
        {
          "ext": "mvuka",
          "name": "Musikkvideouka-prosjekt",
          "role": "Editor"
        }
      ]
    }
  }
}
